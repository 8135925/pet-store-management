<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petshop.module.boarding.BoardingLogMapper">

    <resultMap id="logMap" type="com.petshop.module.boarding.BoardingLog">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="logDate" column="log_date"/>
        <result property="fedCount" column="fed_count"/>
        <result property="walked" column="walked"/>
        <result property="note" column="note"/>
        <result property="operator" column="operator"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByOrder" resultMap="logMap">
        SELECT * FROM boarding_log WHERE order_id = #{orderId} ORDER BY log_date ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO boarding_log(order_id, log_date, fed_count, walked, note, operator, created_at)
        VALUES(#{orderId}, #{logDate}, #{fedCount}, #{walked}, #{note}, #{operator}, #{createdAt})
    </insert>
</mapper>
